# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en hoort nooit in git terecht te komen.

# --- Supabase ---------------------------------------------------------------
# Te vinden via de knop Connect in het Supabase-dashboard, of onder
# Project Settings, API Keys. Bij een nieuw project heten de sleutels
# publishable en secret; die vul je hier gewoon in.

NEXT_PUBLIC_SUPABASE_URL=https://jouwproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# De service role key omzeilt Row Level Security en wordt alleen server-side
# gebruikt (app/api en scripts). Deel hem met niemand.
SUPABASE_SERVICE_ROLE_KEY=

# --- Inloggen ---------------------------------------------------------------
# Gebruikersnamen worden intern omgezet naar een e-mailadres op dit domein,
# bijvoorbeeld jan.jansen@rooster.intern. Er wordt nooit post naartoe gestuurd.
# Wijzig dit niet meer nadat er accounts zijn aangemaakt: bestaande gebruikers
# kunnen dan niet meer inloggen.

NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=rooster.intern

# --- Cron -------------------------------------------------------------------
# Zelf te kiezen willekeurige waarde. Vercel stuurt hem mee bij de dagelijkse
# keepalive-aanroep, zodat niet iedereen die route kan aanroepen.
# Lokaal mag deze leeg blijven.

CRON_SECRET=
